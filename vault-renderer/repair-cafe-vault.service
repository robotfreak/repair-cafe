[Unit]
Description=Repair-Café Vault Renderer (Web-Interface)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/repair-cafe/vault-renderer
ExecStart=/home/pi/repair-cafe/vault-renderer/venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
